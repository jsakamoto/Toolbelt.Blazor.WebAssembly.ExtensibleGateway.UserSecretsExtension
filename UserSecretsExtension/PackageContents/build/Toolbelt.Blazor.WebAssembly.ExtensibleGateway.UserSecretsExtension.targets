<Project>

  <Target Name="BzExGateway_UserSecrets_PrepareResponseFile" BeforeTargets="BzExGateway_GenerateResponseFile">
    <ItemGroup>
      <BzExGatewayAssemblyPath Include="$(MSBuildThisFileDirectory)../tools/net11.0/Toolbelt.Blazor.WebAssembly.ExtensibleGateway.UserSecretsExtension.dll" />
      <!-- The gateway runs in a process of its own, so the only way it can learn which secrets
           store belongs to the project being served is to be told through this variable. -->
      <BzExGatewayEnvValue Include="DOTNET_USER_SECRETS_ID=$(UserSecretsId)" />
    </ItemGroup>
  </Target>

</Project>
