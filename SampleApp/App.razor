@using System.Runtime.InteropServices
@inject IConfiguration Configuration

<div style="text-align:center; font-family:sans-serif;">
    <h1>Blazor WebAssembly App</h1>
    <h2>User Secrets Extension for Extensible Gateway</h2>
    <p>
        @RuntimeInformation.OSDescription /
        @RuntimeInformation.ProcessArchitecture /
        @RuntimeInformation.FrameworkDescription
    </p>

    <p style="font-size:1.5rem;">
        <code>Configuration["Foo:Bar"]</code>
        is
        <strong>"@this.Configuration["Foo:Bar"]"</strong>
    </p>

    <p>
        The value above comes from <code>appsettings.json</code>, overridden by
        <code>appsettings.Development.json</code>, overridden by your <strong>User Secrets</strong>.
    </p>

</div>
